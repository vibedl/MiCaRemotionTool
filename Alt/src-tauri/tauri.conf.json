{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Room Flythrough Studio",
  "version": "1.0.0",
  "identifier": "com.thomasdietsch.roomflythrough",
  "build": {
    "beforeDevCommand": "corepack pnpm run webapp",
    "beforeBuildCommand": "corepack pnpm run build:webapp",
    "frontendDist": "../dist-webapp",
    "devUrl": "http://localhost:5183"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Room Flythrough Studio",
        "width": 1440,
        "height": 920,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/studio": "studio"
    }
  }
}
